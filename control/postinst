#!/bin/sh
set -u
DST=/usr/lib/enigma2/python/Plugins/SystemPlugins/PanelAIO
OLD=/usr/lib/enigma2/python/Plugins/Extensions/PanelAIO
LOGDIR=/tmp/PanelAIO/logs
LOG=$LOGDIR/postinst.log
mkdir -p "$LOGDIR" 2>/dev/null || true
: > "$LOG" 2>/dev/null || true
fail(){ echo "AIO Panel postinst: $1" | tee -a "$LOG" >&2; exit 1; }

for F in core/password.py data/catalog.py install_feed_package.sh install_fury_package.sh core/oscam_data.py data/navigation.py data/owned_projects.py data/requested_installers.py plugin.py runtime.py legacy_plugin.py version.txt BUILD_ID.txt aio_safe_common.sh install_e2iplayer.sh install_archive_script.sh core/smart_channel_merge.py picon_install_script.sh restore_channels_script.sh install_softcam_feed_safe.sh install_oscam_emu_script.sh install_iptv_dream_safe.sh install_s4aupdater_safe.sh install_picon_updater_safe.sh install_myupdater_safe.sh ui/modern.py ui/appearance.py ui/media_list.py core/skin_previews.py assets/previews/credits.txt ui/screens/connect.py assets/modern/qr_site.png assets/modern/qr_community.png assets/modern/qr_report.png core/logger.py core/result.py core/action_registry.py core/activity.py core/source_registry.py core/selftest.py core/python_syntax_check.py core/third_party_package_validator.py install_github_package_safe.sh install_phub_safe.sh; do
    [ -s "$DST/$F" ] || fail "missing required file: $F"
done

[ "$(cat "$DST/version.txt" 2>/dev/null)" = "18.2.1" ] || fail "unexpected version.txt"
grep -Fq 'AIO Panel 18.2.1' "$DST/BUILD_ID.txt" || fail "18.2.1 build marker missing"

PY="${AIO_PYTHON:-}"
[ -z "$PY" ] && command -v python3 >/dev/null 2>&1 && PY=python3
[ -z "$PY" ] && command -v python >/dev/null 2>&1 && PY=python
[ -n "$PY" ] || fail "Python interpreter not found"

# The build manifest contains only files delivered by this package. The checker
# keeps the Python 2 compatibility subset and runs /bin/sh -n without executing scripts.
"$PY" "$DST/core/python_syntax_check.py" --package "$DST" >> "$LOG" 2>&1 || fail "package source validation failed (Python / shell / manifest)"

"$PY" "$DST/core/selftest.py" "$DST" >> "$LOG" 2>&1 || fail "AIO 18.2.1 self-test failed"

# Remove stale development/report files that could remain after upgrading from older packages.
rm -f "$DST"/AIO_PANEL_*_ZMIANY.txt "$DST"/AIO_PANEL_*_POPRAWKI.txt "$DST"/AIO_PANEL_AWARYJNE_USUNIECIE.txt 2>/dev/null || true
rm -f "$DST"/AIO_Panel_*_TEST_REPORT.txt "$DST"/*_FIX_TEST_REPORT.txt "$DST"/ARCHITECTURE_*.md "$DST"/CHANNELS_FIX_TEST_REPORT.txt 2>/dev/null || true
rm -f "$DST"/CHANNEL_INSTALL_FIX_*.txt "$DST"/FIXES_*.txt "$DST"/GITHUB_REPLACEMENT_INSTRUCTIONS.txt "$DST"/LIST_ORDER_FIX_*.txt 2>/dev/null || true
rm -f "$DST"/SUPERCONFIG_*.txt "$DST"/SUPER_CONFIG_*.txt "$DST"/UPDATE_ONLINE_FIX_*.txt "$DST"/README.md "$DST"/RELEASES.md 2>/dev/null || true

find "$DST" -type d -name __pycache__ -exec rm -rf {} \; 2>/dev/null || true
find "$DST" -type f \( -name '*.pyc' -o -name '*.pyo' -o -name '*.before_full_repair' \) -delete 2>/dev/null || true

# Preserve a surviving manually installed copy outside Enigma2's plugin paths.
# Do not follow a symlink or overwrite any existing backup.
if [ -L "$OLD" ]; then
    fail "legacy plugin path is a symlink; left untouched: $OLD"
elif [ -d "$OLD" ]; then
    BACKUPS=/var/backups
    mkdir -p "$BACKUPS" || fail "cannot create $BACKUPS; legacy copy left in place"
    BACKUP=$(mktemp -d "$BACKUPS/panelaio-legacy.XXXXXX") || fail "cannot reserve a legacy backup directory"
    mv "$OLD" "$BACKUP/PanelAIO" || fail "cannot move legacy copy to $BACKUP"
    printf 'Legacy PanelAIO moved to %s/PanelAIO\n' "$BACKUP" >> "$LOG"
fi
rm -f /tmp/PanelAIO/preupgrade_version 2>/dev/null || true
sync 2>/dev/null || true
exit 0
