#!/bin/sh
set -u
DST=/usr/lib/enigma2/python/Plugins/SystemPlugins/PanelAIO
OLD=/usr/lib/enigma2/python/Plugins/Extensions/PanelAIO
LOGDIR=/tmp/PanelAIO/logs
LOG=$LOGDIR/postinst.log
mkdir -p "$LOGDIR" 2>/dev/null || true
: > "$LOG" 2>/dev/null || true
fail(){ echo "AIO Panel postinst: $1" | tee -a "$LOG" >&2; exit 1; }

for F in plugin.py runtime.py legacy_plugin.py version.txt BUILD_ID.txt aio_safe_common.sh install_e2iplayer.sh install_archive_script.sh picon_install_script.sh restore_channels_script.sh install_softcam_feed_safe.sh install_oscam_emu_script.sh install_iptv_dream_safe.sh install_s4aupdater_safe.sh install_picon_updater_safe.sh install_myupdater_safe.sh ui/modern.py ui/screens/connect.py assets/modern/qr_site.png assets/modern/qr_community.png assets/modern/qr_report.png core/logger.py core/result.py core/action_registry.py core/activity.py core/source_registry.py core/selftest.py; do
    [ -s "$DST/$F" ] || fail "missing required file: $F"
done

[ "$(cat "$DST/version.txt" 2>/dev/null)" = "16.0.0" ] || fail "unexpected version.txt"
grep -Fq 'AIO Panel 16.0.0' "$DST/BUILD_ID.txt" || fail "16.0.0 build marker missing"

PY=""
command -v python3 >/dev/null 2>&1 && PY=python3
[ -z "$PY" ] && command -v python >/dev/null 2>&1 && PY=python
[ -n "$PY" ] || fail "Python interpreter not found"

# Full module validation on Python 3. On legacy Python 2 images validate the runtime entry set,
# preserving compatibility with optional modules that may intentionally be Py3-only/hidden.
if "$PY" -c 'import sys; raise SystemExit(0 if sys.version_info[0] >= 3 else 1)' >/dev/null 2>&1; then
    "$PY" -m compileall -q "$DST" >> "$LOG" 2>&1 || fail "Python syntax validation failed"
else
    "$PY" -m py_compile "$DST/plugin.py" "$DST/runtime.py" "$DST/legacy_plugin.py" "$DST/ui/modern.py" "$DST/ui/screens/connect.py" >> "$LOG" 2>&1 || fail "Python 2 compatibility syntax validation failed"
fi

find "$DST" -type f -name '*.sh' -print 2>/dev/null | while IFS= read -r S; do
    /bin/sh -n "$S" >> "$LOG" 2>&1 || exit 1
done || fail "shell syntax validation failed"

"$PY" "$DST/core/selftest.py" "$DST" >> "$LOG" 2>&1 || fail "AIO 16.0.0 self-test failed"

find "$DST" -type f -name '*.sh' -exec chmod 755 {} \; 2>/dev/null || true
find "$DST" -type f -name '*.py' -exec chmod 644 {} \; 2>/dev/null || true
find "$DST" -type f -name '*.png' -exec chmod 644 {} \; 2>/dev/null || true

# Remove stale development/report files that could remain after upgrading from older packages.
rm -f "$DST"/AIO_PANEL_*_ZMIANY.txt "$DST"/AIO_PANEL_*_POPRAWKI.txt "$DST"/AIO_PANEL_AWARYJNE_USUNIECIE.txt 2>/dev/null || true
rm -f "$DST"/AIO_Panel_*_TEST_REPORT.txt "$DST"/*_FIX_TEST_REPORT.txt "$DST"/ARCHITECTURE_*.md "$DST"/CHANNELS_FIX_TEST_REPORT.txt 2>/dev/null || true
rm -f "$DST"/CHANNEL_INSTALL_FIX_*.txt "$DST"/FIXES_*.txt "$DST"/GITHUB_REPLACEMENT_INSTRUCTIONS.txt "$DST"/LIST_ORDER_FIX_*.txt 2>/dev/null || true
rm -f "$DST"/SUPERCONFIG_*.txt "$DST"/SUPER_CONFIG_*.txt "$DST"/UPDATE_ONLINE_FIX_*.txt "$DST"/README.md "$DST"/RELEASES.md 2>/dev/null || true

find "$DST" -type d -name __pycache__ -exec rm -rf {} \; 2>/dev/null || true
find "$DST" -type f \( -name '*.pyc' -o -name '*.pyo' -o -name '*.before_full_repair' \) -delete 2>/dev/null || true

# Remove only the obsolete duplicate after the new SystemPlugins copy passed validation.
if [ -d "$OLD" ] && [ "$OLD" != "$DST" ]; then
    rm -rf "$OLD" 2>/dev/null || true
fi
rm -f /tmp/PanelAIO/preupgrade_version 2>/dev/null || true
sync 2>/dev/null || true
exit 0
